script:post-response {
  expect(res.getStatus()).to.equal(200);
  
}

docs {
  ## Post Webhook (Mimic)
  Example payload sent to the external webhook endpoint in "mimic" scenarios
  (e.g. Mimic reversal / Mimic clearing). Used to simulate Marqeta webhook events
  against the local/ngrok service.
  Change `type` to "authorization.clearing" for clearing mimic.
  Expected status: 200
}
