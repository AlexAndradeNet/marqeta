meta {
  name: Post Webhook (Mimic Event)
  type: http
  seq: 9
}

post {
  url: {{webhookEndpoint}}
  body: json
  auth: none
}

headers {
  Authorization: {{authHeader}}
  Accept: */*
  Content-Type: application/json
}

