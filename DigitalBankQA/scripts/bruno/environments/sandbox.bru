vars {
  baseUrl: https://sandbox-api.marqeta.com/v3
  localPort: http://localhost:8080
  fundingSourceUrl: {{webhookBase}}/external/gateway/jit
  webhookEndpoint: {{webhookBase}}/external/webhook
  webhookUser: my_username
  jitUsername: my_username_of_20_char
}
vars:secret [
  @description('Your Marqeta User')
  marqetaUser,
  @description('Value: p4ssw0rd0fMin20Characters_')
  jitPassword,
  @description('Value: My_passw0rd')
  webhookPass,
  @description('Your Marqeta Pass')
  marqetaPass,
  @description("Don't change it. No a secret, but it prevents Git from tracking it's changes")
  userToken,
  @description("Don't change it. No a secret, but it prevents Git from tracking it's changes")
  cardProductToken,
  @description("Don't change it. No a secret, but it prevents Git from tracking it's changes")
  cardToken,
  @description("Don't change it. No a secret, but it prevents Git from tracking it's changes")
  fundingSourceToken,
  @description("Don't change it. No a secret, but it prevents Git from tracking it's changes")
  originalTxnToken,
  @description("Update your Ngrok URL. No a secret, but it prevents Git from tracking it's changes")
  webhookBase
]
